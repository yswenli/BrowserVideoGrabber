<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BrowserVideoGrabber.Infrastructure</RootNamespace>
    <AssemblyName>BrowserVideoGrabber.Infrastructure</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Description>BrowserVideoGrabber 具体实现：WebView2 嗅探、HTTP / ffmpeg 下载器、进程运行、任务持久化。</Description>
    <EnableAotAnalyzers>true</EnableAotAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserVideoGrabber.Core\BrowserVideoGrabber.Core.csproj" />
  </ItemGroup>

</Project>