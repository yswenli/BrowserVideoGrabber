<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BrowserVideoGrabber.App</RootNamespace>
    <AssemblyName>BrowserVideoGrabber</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Description>BrowserVideoGrabber 主程序：内置浏览器 + 页面视频嗅探 + 多格式视频下载。</Description>
    <StartupObject>BrowserVideoGrabber.App.Program</StartupObject>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <!-- Native AOT：条件启用 -->
    <PublishAot Condition="'$(PublishAot)' == 'true'">true</PublishAot>
    <InvariantGlobalization Condition="'$(PublishAot)' == 'true'">true</InvariantGlobalization>
    <EnableAotAnalyzers>true</EnableAotAnalyzers>
    <!-- IL3050/IL2026 是分析器保守提醒：我们的 JsonSerializerOptions 已绑定 Source Generator TypeInfoResolver，运行时零反射 -->
    <NoWarn Condition="'$(PublishAot)' == 'true'">IL3050;IL2026</NoWarn>
    <!-- WinForms + AOT 绕过默认剪裁硬错误，rd.xml 做根保留 -->
    <_SuppressWinFormsTrimError Condition="'$(PublishAot)' == 'true'">true</_SuppressWinFormsTrimError>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  

  <ItemGroup>
    <TrimmerRootDescriptor Include="rd.xml" />
  </ItemGroup>

</Project>
